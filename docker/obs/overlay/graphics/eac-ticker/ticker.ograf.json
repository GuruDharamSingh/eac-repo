{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "eac-ticker",
  "version": "1.0.0",
  "name": "Ticker",
  "description": "A band along the bottom with text scrolling across it, and an optional label at the left.",
  "author": { "name": "Elkdonis Arts Collective" },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "title": "Label", "default": "Notice", "maxLength": 30, "gddType": "single-line" },
      "text": { "type": "string", "title": "Text", "default": "", "maxLength": 600, "gddType": "multi-line" },
      "speed": { "type": "number", "title": "Speed (pixels a second)", "default": 120, "minimum": 30, "maximum": 600 },
      "accent": { "type": "string", "title": "Accent", "default": "#8a6d1f", "gddType": "color-rrggbb" }
    }
  }
}
