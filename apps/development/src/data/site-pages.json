       "html": "<div style='margin:0 auto;max-width:72rem;padding:3rem 1.25rem'><header style='max-width:42rem'><p style='font-family:ui-monospace,monospace;font-size:.75rem;text-transform:uppercase;letter-spacing:.18em;color:hsl(var(--muted-foreground))'>Paris</p><h1 style='margin-top:.5rem;font-size:2.25rem;line-height:1.15'>Places</h1><p style='margin-top:.75rem;color:hsl(var(--muted-foreground))'>The places our walks stop at: what each one is, the tours that visit it, where to read more, and what visitors say.</p></header><div style='margin-top:2.5rem;display:grid;gap:1.5rem;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)'><ul style='list-style:none;margin:0;padding:0;display:grid;gap:.75rem'><li style='border:1px solid hsl(var(--border));border-radius:var(--radius,.5rem);background:hsl(var(--card));padding:.9rem 1rem'><strong>Place du Tertre</strong><span style='display:block;margin-top:.25rem;font-size:.8rem;color:hsl(var(--muted-foreground))'>A hilltop square and its painters</span></li><li style='border:1px solid hsl(var(--border));border-radius:var(--radius,.5rem);background:hsl(var(--card));padding:.9rem 1rem'><strong>Pont Neuf</strong><span style='display:block;margin-top:.25rem;font-size:.8rem;color:hsl(var(--muted-foreground))'>The oldest standing bridge in the city</span></li><li style='border:1px solid hsl(var(--border));border-radius:var(--radius,.5rem);background:hsl(var(--card));padding:.9rem 1rem'><strong>Passage des Panoramas</strong><span style='display:block;margin-top:.25rem;font-size:.8rem;color:hsl(var(--muted-foreground))'>A covered arcade from 1799</span></li></ul><div style='min-height:18rem;border:1px solid hsl(var(--border));border-radius:var(--radius,.5rem);background:linear-gradient(135deg,hsl(var(--muted)),hsl(var(--card)));display:flex;align-items:center;justify-content:center;color:hsl(var(--muted-foreground));font-size:.85rem'>Map of the places</div></div></div>"
