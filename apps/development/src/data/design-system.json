{
 "name": "Elkdonis Frame (working name)",
 "version": "0.1-suggestion",
 "date": "2026-11-20",
 "status": "proposal, not adopted",
 "principle": "Roles are named for meaning, never for a place or an app. Every old name stays and becomes an alias that reads the role.",
 "how_aliases_work": "Additive: old family declarations gain the role as their final fallback (--sf-bg: var(--eac-surface-bg, var(--eac-ground, #fff))). No old name is removed; apps that set nothing change nothing.",
 "layers": [
  {
   "id": "foundations",
   "label": "Foundations",
   "summary": "colour roles, type roles, space, radius, elevation, motion"
  },
  {
   "id": "surfaces",
   "label": "Surfaces",
   "summary": "face, sheet, stage, strip, card"
  },
  {
   "id": "flows",
   "label": "Flows",
   "summary": "wizard steps, row cards, readiness, side panel"
  },
  {
   "id": "chrome",
   "label": "Page chrome",
   "summary": "header and footer regions and parts"
  }
 ],
 "groups": [
  {
   "id": "colour",
   "layer": "foundations",
   "label": "Colour roles",
   "tokens": [
    {
     "name": "--eac-ground",
     "kind": "color",
     "description": "Page and panel background"
    },
    {
     "name": "--eac-ground-soft",
     "kind": "color",
     "description": "Sunken or tinted background: fields, wells, hover"
    },
    {
     "name": "--eac-ink",
     "kind": "color",
     "description": "Main text"
    },
    {
     "name": "--eac-ink-muted",
     "kind": "color",
     "description": "Secondary text, hints"
    },
    {
     "name": "--eac-ink-faint",
     "kind": "color",
     "description": "Placeholders, disabled"
    },
    {
     "name": "--eac-line",
     "kind": "color",
     "description": "Hairline borders"
    },
    {
     "name": "--eac-rule",
     "kind": "color",
     "description": "Strong rule under heads and feet"
    },
    {
     "name": "--eac-accent",
     "kind": "color",
     "description": "The one brand colour: fills, focus, current step"
    },
    {
     "name": "--eac-accent-ink",
     "kind": "color",
     "description": "Accent used as TEXT on the ground (must pass 4.5:1)"
    },
    {
     "name": "--eac-on-accent",
     "kind": "color",
     "description": "Text that sits on a filled accent"
    },
    {
     "name": "--eac-accent-soft",
     "kind": "color",
     "description": "Accent as a quiet fill (chips, selected row)"
    },
    {
     "name": "--eac-danger",
     "kind": "color",
     "description": "Errors and destructive actions"
    },
    {
     "name": "--eac-ok",
     "kind": "color",
     "description": "Done, ready, saved"
    },
    {
     "name": "--eac-warn",
     "kind": "color",
     "description": "Needs attention"
    },
    {
     "name": "--eac-scrim",
     "kind": "rgba",
     "description": "Backdrop behind a popup"
    },
    {
     "name": "--eac-kind",
     "kind": "color",
     "description": "Accent of the thing being shown; set per element by data-kind"
    },
    {
     "name": "--eac-on-kind",
     "kind": "color",
     "description": "Text on a filled kind colour"
    }
   ]
  },
  {
