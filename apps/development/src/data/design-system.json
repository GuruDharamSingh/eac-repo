 "families": [
  {
   "pattern": "--eac-surface-*",
   "package": "cms-ui surface",
   "where": "packages/cms-ui/src/surface/surface.css",
   "role": "Public override hooks of the surface system; apps set these in :root",
   "tier": "hook"
  },
  {
   "pattern": "--sf-*",
   "package": "cms-ui surface",
   "where": "surface.css :root",
   "role": "Internal resolved values (50 names); read by faces, sheets, fields",
   "tier": "internal"
  },
  {
   "pattern": "--eac-kind-*",
   "package": "cms-ui surface",
   "where": "surface.css",
   "role": "Per-kind accent, 19 kinds plus -on",
   "tier": "hook"
  },
  {
   "pattern": "--fld-*",
   "package": "cms-ui wizard",
   "where": "packages/cms-ui/src/wizard/fields.css",
   "role": "Field controls; fall back to --sf-*",
   "tier": "internal"
  },
  {
   "pattern": "--eac-field-*",
   "package": "cms-ui wizard",
   "where": "fields.css",
   "role": "Public hooks for fields",
   "tier": "hook"
  },
  {
   "pattern": "--eac-form-*",
   "package": "studio-forms",
   "where": "packages/studio-forms theme/forms.css",
   "role": "Public hooks for Studio forms (~60)",
   "tier": "hook"
  },
  {
   "pattern": "--frm-*",
   "package": "studio-forms",
   "where": "studio-forms",
   "role": "Resolved tokens components read (86)",
   "tier": "internal"
  },
  {
   "pattern": "--eac-block-*",
   "package": "page-builder blocks",
   "where": "blocks.css",
   "role": "Public hooks for Puck blocks (27)",
   "tier": "hook"
  },
  {
   "pattern": "--blk-*",
   "package": "page-builder blocks",
   "where": "blocks.css",
   "role": "Resolved block tokens (36)",
   "tier": "internal"
  },
  {
   "pattern": "--eac-control-*",
   "package": "elktours globals",
   "where": "apps/elktours/src/app/globals.css",
   "role": "Control hooks (shadcn bridge)",
   "tier": "hook"
  },
  {
   "pattern": "shadcn --background etc.",
   "package": "apps",
   "where": "each app globals.css",
   "role": "HSL triplets: background foreground card muted border primary destructive radius",
   "tier": "app"
  },
  {
   "pattern": "--font-*",
   "package": "@elkdonis/fonts",
   "where": "packages/fonts/src/roles.ts",
   "role": "Font roles: body heading nav caption reading",
   "tier": "hook"
  },
  {
   "pattern": "--dm-*",
   "package": "danamccool",
   "where": "apps/danamccool/src/lib/theme.ts",
   "role": "Fonts, nav, plate, diamond (22)",
   "tier": "app"
  },
  {
   "pattern": "--ig-*",
   "package": "innergathering",
   "where": "apps/innergathering",
   "role": "141 names: palette --ig-c-*, translucent --ig-a-*, fonts",
   "tier": "app"
  },
  {
   "pattern": "--pts-*",
   "package": "sunjay",
   "where": "apps/sunjay/src/components/site/pts.css",
   "role": "Header height",
   "tier": "app"
  }
 ],
