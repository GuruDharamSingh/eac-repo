# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_AUTH_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Realtime WebSocket URL (port 4000)
NEXT_PUBLIC_SUPABASE_REALTIME_URL=ws://localhost:4000/socket

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elkdonis_dev

# Cloudflare Turnstile (bot protection on the baroque signup / landing page)
# Public site key is rendered client-side; the secret key verifies tokens
# server-side in @elkdonis/auth-server. When unset, the Turnstile widget is
# skipped and signup proceeds without the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
