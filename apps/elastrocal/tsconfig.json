{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Strict here only (the root config is strict: false), as in pigeonshoot:
    // discriminated-union results need strictNullChecks to narrow.
    "strict": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
