{
  "name": "elkdonis-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types && node scripts/check-client-barrels.mjs && node scripts/check-workshop-fields.mjs",
    "check-barrels": "node scripts/check-client-barrels.mjs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@mantine/core": "^8.3.2",
    "@mantine/hooks": "^8.3.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "prosemirror-view": "1.42.3",
      "prosemirror-model": "1.25.11",
      "prosemirror-transform": "1.12.1",
      "prosemirror-state": "1.4.4"
    }
  }
}
