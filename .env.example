# ==================================================================
# EAC Network - Environment Configuration
# ==================================================================
# Copy this file to `.env` and update ALL values for your environment.
# On a new server, update the IP/hostname entries to match your setup.
# NEVER commit the actual .env file to version control.
# ==================================================================

# ------------------------------------------------------------------
# Server / Network
# ------------------------------------------------------------------
# The IP or hostname of your server (used to build URLs below)
SERVER_HOST=localhost

# Allowed dev origins for Next.js (comma-separated, e.g. "192.168.1.10:3004,myhost:3004")
ALLOWED_DEV_ORIGINS=

# Redirect URLs for Supabase Auth (comma-separated)
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elkdonis_dev
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/elkdonis_dev

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# Supabase / GoTrue Auth
# ------------------------------------------------------------------
SUPABASE_URL=http://localhost:9999
NEXT_PUBLIC_SUPABASE_URL=http://localhost:9999
SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-key
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
REALTIME_SECRET=replace-with-longer-random-string-at-least-64-chars
SUPABASE_DB_PASSWORD=supabase_dev_password

# Optional Google OAuth provider settings
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9999/callback

# Auth settings
SITE_URL=http://localhost:3000
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
JWT_EXPIRY=3600

# ------------------------------------------------------------------
# Nextcloud
# ------------------------------------------------------------------
# Internal URL (Docker network or direct)
NEXTCLOUD_URL=http://nextcloud-nginx:80
# Public URL (accessible from user's browser)
NEXT_PUBLIC_NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_PUBLIC_URL=http://localhost:8080
# Production URL (if different)
NEXTCLOUD_PRODUCTION_URL=
# Admin credentials
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
# OIDC secret for Nextcloud Social Login
NEXTCLOUD_OIDC_SECRET=change-me-to-random-secret
# Webhook secret
NEXTCLOUD_WEBHOOK_SECRET=change-me-to-random-secret
# Auto-provision Nextcloud users from auth signup flow
NEXTCLOUD_AUTO_PROVISION=false
NEXTCLOUD_DEFAULT_GROUP=EAC_Network

# ------------------------------------------------------------------
# App URLs (used in docker-compose and for cross-app links)
# ------------------------------------------------------------------
ADMIN_URL=http://localhost:3000
BLOG_SUNJAY_URL=http://localhost:3001
BLOG_GURU_DHARAM_URL=http://localhost:3002
FORUM_URL=http://localhost:3003
INNER_GATHERING_URL=http://localhost:3004
EAC_URL=http://localhost:3005
# Fourth Way Book Readers. Served under a sub-path of elkdonis-arts.org for
# now; set FOURTHWAY_BASE_PATH= (empty) when it gets a domain of its own.
FOURTHWAY_BOOKREADERS_URL=http://localhost:3019/books
FOURTHWAY_BASE_PATH=/books
REALTIME_URL=ws://localhost:4000/socket

# Browser-reachable Silex editor origin. Dev can use http://localhost:6805;
# production should point at the reverse-proxied editor origin.
# Where /edit/{slug} sends the browser. In production this is the public
# subdomain in front of the Silex container (see DEPLOYMENT below), e.g.
# https://silex.arts-collective.com — matching artdirect.arts-collective.com.
SILEX_EDITOR_PUBLIC_URL=http://localhost:6805
# Public origin the Silex container advertises (SILEX_URL inside the container).
# Must match SILEX_EDITOR_PUBLIC_URL, or the editor loads its own assets from an
# origin the browser cannot reach.
SILEX_PUBLIC_URL=http://localhost:6805
# Signs the Silex editor's cookie-session. Set a real random value in production.
SILEX_SESSION_SECRET=eac-dev-silex-session-secret-change-me
# Shared secret the Silex connector presents to arts-collective /api/silex/auth.
# Without it the redeem route answers 404 to everyone. openssl rand -hex 32
SILEX_BRIDGE_SECRET=<generate-with-openssl-rand-hex-32>

# ------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
EMAIL_CLIENT=smtp
SMTP_MAX_FREQUENCY=5s

# Mailer URL paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ------------------------------------------------------------------
# SendGrid — transactional email (@elkdonis/email package)
# Used by: amrit-canada, elkdonis-arts-collective, ifac
# ------------------------------------------------------------------
SENDGRID_API_KEY=your-sendgrid-api-key
# Verified sender domain — use your SendGrid-authenticated address
EMAIL_FROM=info@em6860.elkdonis-arts.org
# Owner notification recipients (override per-app defaults)
EAC_OWNER_EMAIL=info@elkdonis-arts.org
AMRIT_CANADA_OWNER_EMAIL=gurudharamsingh@gmail.com
IFAC_OWNER_EMAIL=info@ifacgroup.com
# Domains whose SPF+DKIM are authenticated in SendGrid, comma-separated. An
# org's own From address is REFUSED and falls back unless its domain is here —
# sending unauthenticated is worse than sending as the network, because Gmail
# and Yahoo now reject it outright. EMAIL_FROM's own domain is always allowed.
EMAIL_AUTHENTICATED_DOMAINS=
# Put a real request through SendGrid without delivering anything. Set for
# tests, seed scripts and the email doctor.
EMAIL_SANDBOX=

# ------------------------------------------------------------------
# Inbound mail — replies and enquiries coming BACK (@elkdonis/email/inbox)
# ------------------------------------------------------------------
# ONE MX host for the whole network, because SendGrid's Inbound Parse cannot
# route two addresses on one host to two different webhooks — so the org rides
# in the local part instead:
#
#     ifac@inbound.elkdonis-arts.org          a fresh enquiry for `ifac`
#     ifac.<threadId>@inbound.…               a reply on that thread
#
# A SUBDOMAIN, never an org's own domain: ifacgroup.com, amritcanada.ca,
# hiddenenneagram.com and elkdonis-arts.org all carry live Bluehost MX records,
# and pointing those at SendGrid would destroy mailboxes people use.
#
# Setup: add `inbound.elkdonis-arts.org.  MX 10 mx.sendgrid.net.`, then
# SendGrid → Settings → Inbound Parse → Add Host & URL pointing at
# https://arts-collective.com/api/email/inbound
#
# LEAVE BLANK until that MX record exists. Unset, the suite's Inbox tab says
# inbound isn't configured rather than advertising an address that bounces.
EMAIL_INBOUND_DOMAIN=
# Signed Inbound Parse webhook verification key (base64 DER SPKI, from the
# SendGrid console). WITHOUT IT THE ENDPOINT IS FORGEABLE — anyone can POST
# mail into any org's inbox. The route logs that warning on every request.
SENDGRID_INBOUND_PUBLIC_KEY=
# Signed Event Webhook key, for delivery/bounce/spam events at
# /api/email/events. Without it anyone can forge a bounce and get an address
# suppressed network-wide.
SENDGRID_EVENT_PUBLIC_KEY=

# ------------------------------------------------------------------
# Stripe — card payments + Express seller onboarding (@elkdonis/payments)
# Used by: art-auction (and any app that adopts @elkdonis/checkout/stripe)
# Leave blank to run eTransfer-only; the card option is hidden automatically.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for the /api/stripe/webhook route (dashboard, or `stripe listen`).
# Unset, handleStripeWebhook rejects EVERY event — it refuses to trust an
# unsigned payload. Not fatal in dev: syncStripeOrder() and
# refreshStripeAccountStatus() cover both webhook duties on return-visit.
#
# For local delivery (no public URL for art-auction), use the Stripe CLI:
#
#   export STRIPE_API_KEY="$STRIPE_SECRET_KEY"       # avoids the browser login
#   stripe listen --print-secret                      # -> paste below
#   stripe listen --forward-to http://127.0.0.1:3009/api/stripe/webhook
#
# Use 127.0.0.1, NOT localhost: the CLI resolves localhost to ::1, and the
# compose port mapping resets IPv6 connections ("connection reset by peer").
STRIPE_WEBHOOK_SECRET=
# Where an org's earmarked share and maker-less sales are sent by eTransfer
ART_AUCTION_GALLERY_PAYOUT_EMAIL=info@elkdonis-arts.org

# ------------------------------------------------------------------
# pgAdmin (optional)
# ------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# ------------------------------------------------------------------
# S3 Storage (optional - for external media)
# ------------------------------------------------------------------
S3_HOST=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_PORT=443
S3_SSL=true
S3_REGION=us-east-1
NEXTCLOUD_DOMAIN=

# Inter-app authentication (for Talk OAuth flow)
INTER_APP_JWT_SECRET=<generate-with-openssl-rand-base64-32>

# Docker Compose project name override
COMPOSE_PROJECT_NAME=eac

# ==========================================================================
# Meta (Facebook Page + Instagram) — see packages/meta/README.md
# ==========================================================================
# From the Meta App Dashboard. The secret is a credential; never NEXT_PUBLIC_.
META_APP_ID=
META_APP_SECRET=
# Pin the Graph version. Unset follows the app's dashboard default, which can
# change under you. Confirm the current version in the App Dashboard.
META_GRAPH_VERSION=v21.0
# Produced by `node packages/meta/scripts/probe.mjs`. The Page token does not
# expire while the granting user stays a Page admin — treat it as a password.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Only if a Business/Creator Instagram account is linked to the Page.
META_INSTAGRAM_USER_ID=
