{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@elkdonis/utils": ["../utils/src/index.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
