{
  "id": "fold-card",
  "label": "Fold Card",
  "description": "A card that opens into a panel of actions; closing it folds the panel up like paper and drops the card back into place.",
  "credit": {
    "title": "Card → view fold transition",
    "author": "shshaw / keyframers",
    "url": "https://codepen.io/shshaw/pen/QmZYMG"
  },
  "root": ".eac-pen-fold",
  "html": "pen.html",
  "css": "pen.css",
  "react": "@elkdonis/cms-ui/pens FoldCard",
  "traits": [
    {
      "name": "data-speed",
      "label": "Speed",
