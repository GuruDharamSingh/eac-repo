        { "id": "fast", "name": "Fast" },
        { "id": "normal", "name": "Normal" },
        { "id": "slow", "name": "Slow" }
      ]
    },
    {
      "name": "data-ratio",
      "label": "Shape",
      "type": "select",
      "options": [
        { "id": "portrait", "name": "Portrait (3:4)" },
        { "id": "square", "name": "Square" },
        { "id": "tall", "name": "Tall (5:9)" },
        { "id": "wide", "name": "Wide (16:10)" }
      ]
    }
  ]
}
