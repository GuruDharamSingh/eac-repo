          "from": "exhibits.countLabel"
        },
        "exhibitList": {
          "kind": "list",
          "from": "exhibits.items",
          "item": {
            "exhibitHref": {
              "kind": "attr",
              "attr": "href",
              "from": "item.href"
            },
            "exhibitCover": {
              "kind": "attr",
              "attr": "src",
              "from": "item.coverUrl",
              "omitWhenEmpty": true
            },
            "exhibitNoCover": {
              "kind": "show",
              "from": "item.coverUrl",
