            }
          }
        }
      },
      "notes": "Where they have shown, taught, been collected or held a post. Free-form spans with no relations ('Spring 2021', '2019 \u2014 present'), so they live in the dossier's own JSONB rather than a table no query would ever join.",
      "wizard": {
        "label": "Your record",
        "description": "Where you have shown, taught or held a post."
      }
    },
