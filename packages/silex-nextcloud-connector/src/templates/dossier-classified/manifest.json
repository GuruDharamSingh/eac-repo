        "artwork.status",
        "artwork.image_url"
      ],
      "traits": [
        "lotList",
        "storeHref",
        "storeName"
      ],
      "bindings": {
        "storeName": {
          "kind": "text",
          "from": "store.name"
        },
        "storeHref": {
          "kind": "attr",
          "attr": "href",
          "from": "store.href"
        },
        "lotList": {
          "kind": "list",
          "from": "store.lots",
          "item": {
            "lotPlateHref": {
              "kind": "attr",
