              "from": "item.price",
              "omitWhenEmpty": true
            },
            "lotSold": {
              "kind": "text",
              "from": "item.soldLabel",
              "omitWhenEmpty": true
            }
          }
        }
      },
      "notes": "A window onto their marketplace store, not a checkout. Requires an active store AND users.profile_sections.store \u2014 the flag every org site already reads. A sold lot shows the word rather than a price; that precedence is decided in toDossierContext, not here.",
      "wizard": {
        "skip": true
      }
    },
    {
