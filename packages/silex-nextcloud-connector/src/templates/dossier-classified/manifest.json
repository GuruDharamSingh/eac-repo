      "notes": "Their gallery pages (user_galleries, migration 124). Public galleries only, unless the viewer is the owner.",
      "wizard": {
        "skip": true
      }
    },
    {
      "id": "eac-dossier-acquisitions",
      "label": "Acquisitions (their store)",
      "html": "html/eac-dossier-acquisitions.html",
      "css": "css/eac-dossier-acquisitions.css",
      "required": false,
      "repeatable": false,
      "defaultVisible": true,
      "omitWhenEmpty": true,
      "profileSection": "store",
      "cmsFields": [
