{
  "id": "dossier-classified",
  "name": "Artist Dossier",
  "version": "0.3.0",
  "category": "EAC Dossier Template",
  "description": "A private investigator's case file as an artist's network profile. Editorial serif over typewriter, a manila file on a desk, and the person's real published work \u2014 writing, appearances, galleries, store \u2014 filed inside it.",
  "tokens": "../../tokens/dossier-classified.css",
  "context": "toDossierContext",
  "notes": "v0.3 moved this template onto the declarative binding engine. The section HTML is now the only place the markup lives; there are no string builders. Display logic \u2014 'Exhibit C', '18 plates', upcoming vs past, sold beats price \u2014 is in toDossierContext (@elkdonis/cms-bindings/dossier), because the engine's contract is that the manifest declares wiring and nothing conditional. Data is users + org_profiles + threads + user_galleries + store (migrations 084/086). Sections carrying `profileSection` render only when the person has switched that key on in users.profile_sections (migration 105) \u2014 the same flag every org site reads, so a person turns a section on once for the whole network.",
  "cssOrder": [
    "css/eac-dossier-chrome.css",
    "css/eac-dossier-nav.css",
    "css/eac-dossier-identity.css",
    "css/eac-dossier-operations.css",
    "css/eac-dossier-dispatches.css",
    "css/eac-dossier-movements.css",
    "css/eac-dossier-exhibits.css",
    "css/eac-dossier-acquisitions.css",
    "css/eac-dossier-record.css",
    "css/eac-dossier-intelligence.css",
    "css/eac-dossier-network.css",
    "css/eac-dossier-channels.css",
    "css/eac-dossier-funds.css",
    "css/eac-dossier-activity.css"
  ],
  "sections": [
    {
      "id": "eac-dossier-nav",
      "label": "Archive nav",
      "html": "html/eac-dossier-nav.html",
      "css": "css/eac-dossier-nav.css",
      "required": true,
      "repeatable": false,
      "defaultVisible": true,
      "cmsFields": [],
      "traits": [
        "archiveName",
        "indexAction",
        "indexHref"
      ],
      "bindings": {
        "archiveName": {
          "kind": "text",
          "from": "archive.name"
        },
        "indexHref": {
          "kind": "attr",
          "attr": "href",
          "from": "archive.indexHref"
        },
        "indexAction": {
          "kind": "attr",
          "attr": "action",
          "from": "archive.indexHref"
        }
      },
      "notes": "Sticky bar above the file. The search is a real GET form to the directory index; in v0.1 it was an input with no form, no name and no handler.",
      "wizard": {
        "skip": true
      }
    },
    {
      "id": "eac-dossier-identity",
      "label": "Subject identity",
      "html": "html/eac-dossier-identity.html",
      "css": "css/eac-dossier-identity.css",
      "required": true,
      "repeatable": false,
      "defaultVisible": true,
      "cmsFields": [
        "users.display_name",
        "users.headline",
        "users.city",
        "users.region",
        "users.country",
        "users.bio",
        "users.avatar_url",
        "users.claim_status",
        "users.verified",
        "users.oad_dossier.location",
        "users.oad_dossier.dossier_status"
      ],
      "traits": [
        "aliasName",
        "bioBlock",
        "bioNotes",
        "contactBlock",
        "contactHref",
        "fileStatus",
        "location",
        "noPhoto",
        "occupation",
        "photoUrl",
        "stampLabel"
      ],
      "bindings": {
        "stampLabel": [
          {
            "kind": "text",
            "from": "subject.stampLabel"
          },
          {
            "kind": "attr",
            "attr": "data-state",
            "from": "subject.stampState"
          }
        ],
        "photoUrl": [
          {
            "kind": "attr",
            "attr": "src",
            "from": "subject.photoUrl",
            "omitWhenEmpty": true
          },
          {
            "kind": "attr",
            "attr": "alt",
            "from": "subject.photoAlt"
          }
        ],
        "noPhoto": {
          "kind": "show",
          "from": "subject.photoUrl",
          "unless": true
        },
        "aliasName": {
          "kind": "text",
          "from": "subject.name"
        },
        "occupation": {
          "kind": "text",
          "from": "subject.occupation",
          "omitWhenEmpty": true
        },
        "location": {
          "kind": "text",
          "from": "subject.location",
          "omitWhenEmpty": true
        },
        "fileStatus": {
          "kind": "text",
          "from": "subject.fileStatus",
          "omitWhenEmpty": true
        },
        "bioBlock": {
          "kind": "show",
          "from": "subject.bioHtml"
        },
        "bioNotes": {
          "kind": "html",
          "from": "subject.bioHtml"
        },
        "contactBlock": {
          "kind": "show",
          "from": "subject.contactHref"
        },
        "contactHref": {
          "kind": "attr",
          "attr": "href",
          "from": "subject.contactHref"
        }
      },
      "notes": "Portrait, name, the form rows and the notes. An absent occupation or location is REMOVED rather than filled with an em-dash, leaving the row's ruled line \u2014 across the live directory neither field has ever been filled in, and v0.1 printed '\u2014' and the words 'Location withheld' on every page as a result.",
      "wizard": {
        "label": "Who you are",
        "description": "Name, what you do, where, and the note that introduces you."
      }
    },
    {
      "id": "eac-dossier-operations",
      "label": "Known work",
      "html": "html/eac-dossier-operations.html",
      "css": "css/eac-dossier-operations.css",
      "required": false,
      "repeatable": false,
      "defaultVisible": true,
      "omitWhenEmpty": true,
      "cmsFields": [
        "users.portfolio[].url",
        "users.portfolio[].title",
        "users.oad_dossier.operations[].title",
        "users.oad_dossier.operations[].date",
        "users.oad_dossier.operations[].details",
        "users.oad_dossier.operations[].image_url"
      ],
      "traits": [
        "workCount",
        "workList"
      ],
      "bindings": {
        "workCount": {
          "kind": "text",
          "from": "work.countLabel"
        },
        "workList": {
          "kind": "list",
          "from": "work.items",
          "item": {
            "platePlateHref": {
              "kind": "attr",
              "attr": "href",
              "from": "item.plateHref",
              "omitWhenEmpty": true
            },
            "plateImage": [
              {
                "kind": "attr",
                "attr": "src",
                "from": "item.imageUrl",
                "omitWhenEmpty": true
              },
              {
                "kind": "attr",
                "attr": "alt",
                "from": "item.title"
              }
            ],
            "plateRef": {
              "kind": "text",
              "from": "item.ref"
            },
            "plateTitle": {
              "kind": "text",
              "from": "item.title"
            },
            "plateNote": {
              "kind": "text",
              "from": "item.note",
              "omitWhenEmpty": true
            }
          }
        }
      },
      "notes": "The plate wall. Falls back to users.portfolio when no dossier-specific work is written. Thumbnails are grayscale; each links to its full-colour plate in the lightbox section.",
      "wizard": {
        "label": "Your work",
        "description": "The pieces on the wall of the file."
      }
    },
    {
      "id": "eac-dossier-dispatches",
      "label": "Dispatches (their writing)",
      "html": "html/eac-dossier-dispatches.html",
      "css": "css/eac-dossier-dispatches.css",
      "required": false,
      "repeatable": false,
      "defaultVisible": true,
      "omitWhenEmpty": true,
      "profileSection": "dispatches",
      "cmsFields": [
        "threads.title",
        "threads.slug",
        "threads.excerpt",
        "threads.published_at",
        "threads.metadata.coverImageUrl",
        "threads.kind",
        "threads.org_id"
      ],
      "traits": [
        "dispatchCount",
        "dispatchList",
        "leadBlock",
        "leadCover",
        "leadExcerpt",
        "leadFlag",
        "leadHref",
        "leadMeta",
        "leadTitle"
      ],
      "bindings": {
        "dispatchCount": {
          "kind": "text",
          "from": "dispatches.countLabel"
        },
        "leadBlock": [
          {
            "kind": "show",
            "from": "dispatches.lead"
          },
          {
            "kind": "class",
            "class": "eac-dos-lead-nocover",
            "from": "dispatches.leadNoCover"
          }
        ],
        "leadCover": {
          "kind": "attr",
          "attr": "src",
          "from": "dispatches.lead.coverImageUrl",
          "omitWhenEmpty": true
        },
        "leadTitle": {
          "kind": "text",
          "from": "dispatches.lead.title"
        },
        "leadHref": {
          "kind": "attr",
          "attr": "href",
          "from": "dispatches.lead.href"
        },
        "leadFlag": {
          "kind": "text",
          "from": "dispatches.lead.flag",
          "omitWhenEmpty": true
        },
        "leadExcerpt": {
          "kind": "text",
          "from": "dispatches.lead.excerpt",
          "omitWhenEmpty": true
        },
        "leadMeta": {
          "kind": "text",
          "from": "dispatches.lead.meta",
          "omitWhenEmpty": true
        },
        "dispatchList": {
          "kind": "list",
          "from": "dispatches.rest",
          "item": {
            "rowTitle": {
              "kind": "text",
              "from": "item.title"
            },
            "rowHref": {
              "kind": "attr",
              "attr": "href",
              "from": "item.href"
            },
            "rowFlag": {
              "kind": "text",
              "from": "item.flag",
              "omitWhenEmpty": true
            },
            "rowExcerpt": {
              "kind": "text",
              "from": "item.excerpt",
              "omitWhenEmpty": true
            },
            "rowMeta": {
              "kind": "text",
              "from": "item.meta",
              "omitWhenEmpty": true
            },
            "rowDate": {
              "kind": "text",
              "from": "item.date",
              "omitWhenEmpty": true
            }
          },
          "whenEmpty": "remove"
        }
      },
      "notes": "Their blog: threads of kind 'post' and 'writing' they authored anywhere on the network, newest first, the most recent as a lead item. Read-only here \u2014 edited where it was filed.",
      "wizard": {
        "skip": true
      }
    },
    {
      "id": "eac-dossier-movements",
      "label": "Movements (their events)",
      "html": "html/eac-dossier-movements.html",
      "css": "css/eac-dossier-movements.css",
      "required": false,
      "repeatable": false,
      "defaultVisible": true,
      "omitWhenEmpty": true,
