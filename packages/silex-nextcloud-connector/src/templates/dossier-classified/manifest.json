        "threads.location",
        "threads.kind",
        "threads.org_id"
      ],
      "traits": [
        "pastBlock",
        "pastList",
        "upcomingBlock",
        "upcomingList"
      ],
      "bindings": {
        "upcomingBlock": {
          "kind": "show",
          "from": "movements.upcoming"
        },
        "upcomingList": {
          "kind": "list",
          "from": "movements.upcoming",
          "item": {
            "moveMonth": {
              "kind": "text",
              "from": "item.month"
            },
            "moveDay": {
              "kind": "text",
              "from": "item.day"
            },
            "moveYear": {
              "kind": "text",
              "from": "item.year"
            },
            "moveTitle": {
              "kind": "text",
              "from": "item.title"
            },
            "moveHref": {
              "kind": "attr",
              "attr": "href",
              "from": "item.href"
            },
            "moveMeta": {
              "kind": "text",
              "from": "item.meta",
              "omitWhenEmpty": true
            },
            "moveTime": {
              "kind": "text",
              "from": "item.time",
              "omitWhenEmpty": true
            }
          }
        },
        "pastBlock": {
          "kind": "show",
          "from": "movements.past"
        },
        "pastList": {
          "kind": "list",
          "from": "movements.past",
          "item": {
            "moveMonth": {
              "kind": "text",
              "from": "item.month"
            },
            "moveDay": {
              "kind": "text",
              "from": "item.day"
            },
            "moveYear": {
              "kind": "text",
              "from": "item.year"
            },
            "moveTitle": {
              "kind": "text",
              "from": "item.title"
            },
            "moveHref": {
              "kind": "attr",
              "attr": "href",
              "from": "item.href"
            },
            "moveMeta": {
              "kind": "text",
              "from": "item.meta",
              "omitWhenEmpty": true
            },
            "moveTime": {
              "kind": "text",
              "from": "item.time",
              "omitWhenEmpty": true
            }
          }
        }
      },
      "notes": "Dated threads they host \u2014 event, meeting, workshop \u2014 split into upcoming and past. A gathering counts as upcoming until six hours past its start, the same window the org feeds use. Read-only here \u2014 edited on the org that runs it.",
      "wizard": {
        "skip": true
      }
    },
    {
      "id": "eac-dossier-exhibits",
      "label": "Exhibits (their galleries)",
      "html": "html/eac-dossier-exhibits.html",
      "css": "css/eac-dossier-exhibits.css",
      "required": false,
      "repeatable": false,
      "defaultVisible": true,
      "omitWhenEmpty": true,
      "profileSection": "galleries",
      "cmsFields": [
