              "omitWhenEmpty": true
            },
            "lotImage": [
              {
                "kind": "attr",
                "attr": "src",
                "from": "item.imageUrl",
                "omitWhenEmpty": true
              },
              {
                "kind": "attr",
                "attr": "alt",
                "from": "item.title"
              }
            ],
            "lotRef": {
              "kind": "text",
              "from": "item.ref"
            },
            "lotTitle": {
              "kind": "text",
              "from": "item.title"
            },
            "lotHref": {
              "kind": "attr",
              "attr": "href",
              "from": "item.href"
            },
            "lotPrice": {
