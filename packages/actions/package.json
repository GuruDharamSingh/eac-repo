{
  "name": "@elkdonis/actions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./catalogue": "./src/catalogue.ts",
    "./present": "./src/present.ts",
    "./server": "./src/server/index.ts",
    "./anchor": "./src/anchor.ts",
    "./route": "./src/route.ts",
    "./confirm": "./src/confirm.ts"
  },
  "dependencies": {
    "@elkdonis/cms-ui": "workspace:*",
    "@elkdonis/commerce": "workspace:*",
    "@elkdonis/db": "workspace:*",
    "@elkdonis/email": "workspace:*",
    "@elkdonis/services": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "check:registry": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/check-registry.mts",
    "atlas:inventory": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/atlas-inventory.mts",
    "atlas:check": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/check-atlas.mts",
    "check:rails": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/check-rails.mts",
    "atlas:q": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/atlas-q.mts",
    "atlas:reports": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/atlas-reports.mts",
    "atlas:emit": "pnpm --filter @elkdonis/lms exec tsx ../actions/scripts/atlas-emit.mts"
  }
}
