// Emits src/registry-data.ts from atlas/entries.ts plus the wording of the atlas rows it names (2026-11-16).
// `--check` compares instead of writing and exits 1 when the file is stale.
//   pnpm --filter @elkdonis/actions atlas:emit [-- --check]
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { loadAreas } from '../atlas/index';
import { ENTRIES } from '../atlas/entries';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const OUT = path.join(HERE, '../src/registry-data.ts');
const OUT_CONFIRM = path.join(HERE, '../src/server/registry-confirm.ts');

export async function render(): Promise<{ data: string; confirms: string }> {
  const areas = await loadAreas();
  const data: Record<string, unknown> = {};
  const confirms: Record<string, unknown> = {};
  for (const id of Object.keys(ENTRIES).sort()) {
    const e = ENTRIES[id];
    const row: Record<string, unknown> = {};
    if (e.address) row.address = e.address;
    row.risk = e.risk;
    row.roles = e.roles;
    if (e.confirmFrom) {
      const [file, capId] = e.confirmFrom.split(':');
      const cap = areas[file]?.capabilities.find((c) => c.id === capId);
      if (!cap) throw new Error(`entries.ts: ${id}: no atlas row ${e.confirmFrom}`);
      if (!cap.confirm) throw new Error(`entries.ts: ${id}: atlas row ${e.confirmFrom} has no confirm`);
      const c = { text: cap.confirm.text, ...(cap.confirm.title ? { title: cap.confirm.title } : {}), status: cap.confirm.status, ...(cap.confirm.wave !== undefined ? { wave: cap.confirm.wave } : {}) };
      confirms[id] = c;
      // Only approved wording goes into the client-safe file; drafts stay in the server-only one.
      if (c.status === 'approved' || c.status === 'changed') row.confirm = c;
    }
    data[id] = row;
  }
  const header = (what: string) => `// GENERATED by scripts/atlas-emit.mts from atlas/entries.ts and the atlas rows' confirm wording. Do not edit.\n// ${what}\n`;
  const dataText = header('Client-safe: address, risk, roles, and APPROVED confirm wording only. Drafts are in server/registry-confirm.ts.') + `
import type { ActionAddress, ActionConfirm, ActionRisk, ActionRole } from './types';

export interface RegistryData {
  address?: ActionAddress;
  confirm?: ActionConfirm;
  risk: readonly ActionRisk[];
  roles: readonly ActionRole[];
}

export const REGISTRY_DATA: Readonly<Record<string, RegistryData>> = ${JSON.stringify(data, null, 2)};
`;
  const confirmText = header('Server-only: every confirm text with its status (draft, proposed, approved, changed). The dock route resolves it for who is looking (src/confirm.ts); the client never receives drafts.') + `import type { ActionConfirm } from '../types';

export const REGISTRY_CONFIRM: Readonly<Record<string, ActionConfirm>> = ${JSON.stringify(confirms, null, 2)};
`;
  return { data: dataText, confirms: confirmText };
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const text = await render();
  if (process.argv.includes('--check')) {
    const same = (f: string, s: string) => fs.existsSync(f) && fs.readFileSync(f, 'utf8') === s;
    if (!same(OUT, text.data) || !same(OUT_CONFIRM, text.confirms)) {
      console.error('registry-data.ts is stale: run atlas:emit');
      process.exit(1);
    }
    console.log('registry-data.ts is current.');
  } else {
    fs.writeFileSync(OUT, text.data);
    fs.writeFileSync(OUT_CONFIRM, text.confirms);
    console.log(`wrote ${path.relative(process.cwd(), OUT)} (${Object.keys(ENTRIES).length} entries)`);
  }
}
