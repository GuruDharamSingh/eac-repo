// Builds packages/mcp/src/manifest/blocks.generated.ts from the real catalogue.
//
//   run in an eac container from packages/lms (classic JSX, as the MCP test runs):
//   tsx ../mcp/scripts/build-manifest.mts            writes the file
//   tsx ../mcp/scripts/build-manifest.mts --check    exits 1 when the checked-in file is out of date
//
// Reads: the shared blocks (contractOf + each block's own declaration), the record parts (checkout and rsvp
// are made per host; a no-op action stands in), and docs/open/DEVELOPMENT_APP_2026-11-20/blocks.json for
// every block this script cannot import (app-local blocks, the editing box blocks).
import './react-shim.mjs';
import { readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { buildManifest } from '../src/manifest/build';
import type { CatalogueRecord, ContractLike, DefLike } from '../src/manifest/types';

const here = (rel: string) => fileURLToPath(new URL(rel, import.meta.url));
const OUT = here('../src/manifest/blocks.generated.ts');
const CATALOGUE = here('../../../docs/open/DEVELOPMENT_APP_2026-11-20/blocks.json');

const m: any = await import('../../blocks/src/index');
const { contractOf } = await import('../../blocks/src/contract');
const noop = async () => {};
const all = [
  ...m.SHARED_BLOCKS,
  ...m.PROFILE_PAGE_BLOCKS,
  ...m.FEATURED_PAGE_BLOCKS,
  ...m.STORE_PANEL_BLOCKS,
  m.featuredPerson,
  m.recordHeader,
  m.recordBody,
  m.recordFacts,
  m.checkoutBlock({ action: noop }),
  m.rsvpBlock({ action: noop }),
];
const seen = new Set<string>();
const blocks = all.filter((b: any) => b && !seen.has(b.def.id) && (seen.add(b.def.id), true));
const contracts = contractOf(blocks) as unknown as Record<string, ContractLike>;
const defs: Record<string, DefLike> = {};
for (const b of blocks) defs[b.def.id] = b.def;
const catalogue = JSON.parse(readFileSync(CATALOGUE, 'utf8')) as CatalogueRecord[];

const file = buildManifest({ contracts, defs, catalogue });
const text =
  `// GENERATED by scripts/build-manifest.mts. Do not edit; run it again.\n` +
  `// Inputs: the shared block catalogue (contractOf + declarations) and docs/open/DEVELOPMENT_APP_2026-11-20/blocks.json.\n` +
  `import type { ManifestFile } from './types';\n\n` +
  `export const BLOCK_MANIFEST: ManifestFile = {\n v: 1,\n fieldPattern: ${JSON.stringify(file.fieldPattern)},\n recordPattern: ${JSON.stringify(file.recordPattern)},\n blocks: [\n` +
  file.blocks.map((b) => `  ${JSON.stringify(b)},\n`).join('') +
  ` ],\n};\n`;

if (process.argv.includes('--check')) {
  let current = '';
  try {
    current = readFileSync(OUT, 'utf8');
  } catch {
    /* missing */
  }
  const ok = current === text;
  console.log(ok ? `ok   manifest is current (${file.blocks.length} blocks)` : 'FAIL manifest is out of date: run scripts/build-manifest.mts');
  process.exit(ok ? 0 : 1);
}
writeFileSync(OUT, text);
console.log(`wrote ${OUT} (${file.blocks.length} blocks, ${file.blocks.filter((b) => b.agent.read).length} visible to assistants)`);
