{
  "color": {
    "$type": "color",
    "brand": {
      "saffron": {
        "$value": { "colorSpace": "hsl", "components": [45, 79, 52] },
        "$description": "Amrit Canada's primary."
      },
      "oxide": {
        "$value": { "colorSpace": "srgb", "components": [0.596, 0.247, 0.184], "hex": "#983f2f" }
      },
      "veil": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.25 }
      },
      "wide": {
        "$value": { "colorSpace": "display-p3", "components": [0.9, 0.7, 0.1] }
      },
      "future": {
        "$value": { "colorSpace": "jzazbz", "components": [0.1, 0.2, 0.3], "hex": "#445566" }
      }
    },
    "semantic": {
      "accent": { "$value": "{color.brand.saffron}" },
      "accent-again": { "$value": "{color.semantic.accent}" },
      "missing": { "$value": "{color.brand.nope}" },
      "retired": { "$value": "{color.brand.oxide}", "$deprecated": "Use accent instead." }
    },
    "loop": {
      "a": { "$value": "{color.loop.b}" },
      "b": { "$value": "{color.loop.a}" }
    }
  },
  "space": {
    "$type": "dimension",
    "tight": { "$value": { "value": 4, "unit": "px" } },
    "regular": { "$value": { "value": 1, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 0.625, "unit": "rem" } }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": ["Georgia", "serif"] },
    "display": { "$type": "fontFamily", "$value": ["Source Sans 3", "sans-serif"] },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Georgia", "serif"],
        "fontSize": { "value": 1.5, "unit": "rem" },
        "fontWeight": 600,
        "lineHeight": 1.2
      }
    }
  },
  "elevation": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "chrome": {
    "band": {
      "$type": "gradient",
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.212, 0.271, 0.310] }, "position": 0 },
        { "color": { "colorSpace": "srgb", "components": [0.173, 0.243, 0.314] }, "position": 1 }
      ]
    }
  },
  "motion": {
    "quick": {
      "$type": "transition",
      "$value": {
        "duration": { "value": 120, "unit": "ms" },
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": [0.4, 0, 0.2, 1]
      }
    }
  },
  "untyped": {
    "mystery": { "$value": 42 }
  }
}
