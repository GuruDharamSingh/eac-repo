{
  "name": "@elkdonis/openclaw-bridge",
  "version": "1.0.0",
  "description": "The only surface an external agent (OpenClaw) may write through. Contract + authorization + draft creation; holds no standing authority of its own.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit"
  },
  "files": [
    "dist/**"
  ],
  "dependencies": {
    "@elkdonis/db": "workspace:*",
    "@elkdonis/services": "workspace:*",
    "@elkdonis/types": "workspace:*",
    "@elkdonis/utils": "workspace:*",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
